{
  "rewrites": [
    {
      "source": "/shop/:shopName/:token/results",
      "destination": "/api/meta?token=:token&results=1&path=/shop/:shopName/:token/results"
    },
    {
      "source": "/shop/:shopName/:token",
      "destination": "/api/meta?token=:token&path=/shop/:shopName/:token"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
